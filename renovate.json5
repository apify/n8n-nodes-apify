{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  extends: [
    'config:recommended',
    // Dependency bumps are `chore:`, never `fix:`.
    ':semanticCommitTypeAll(chore)',
  ],
  semanticCommits: 'enabled',

  timezone: 'Europe/Prague',
  schedule: ['every weekday'],
  labels: ['t-integration', 'dependencies'],

  minimumReleaseAge: '3 days',
  // Skip a version while it is still in cooldown instead of opening a pending PR.
  internalChecksFilter: 'strict',

  // Weekly lockfile rebuild — the only time transitive dependencies are refreshed.
  lockFileMaintenance: {
    enabled: true,
  },
}
