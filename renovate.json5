{
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',

	extends: [
		'config:recommended',
		// Dependency bumps are `chore:`, never `fix:`.
		':semanticCommitTypeAll(chore)',
	],
	semanticCommits: 'enabled',

	timezone: 'Europe/Prague',
	schedule: ['* * * * 3'],
	labels: ['t-integrations', 'dependencies'],
	reviewers: ['drobnikj', 'protoss70'],

	// Merge once CI is green and the PR is approved — the master ruleset requires 1 approval,
	// so GitHub auto-merge waits for a review instead of merging unreviewed.
	automerge: true,
	platformAutomerge: true,

	minimumReleaseAge: '7 days',
	// Skip a version while it is still in cooldown instead of opening a pending PR.
	internalChecksFilter: 'strict',

	// Weekly lockfile rebuild — the only time transitive dependencies are refreshed.
	lockFileMaintenance: {
		enabled: true,
		schedule: ['* * * * 3'],
	},

	packageRules: [
		{
			// nock 15 (and its @mswjs/interceptors dependency) is ESM-only, while Jest runs ts-jest in
			// CommonJS, so the specs fail to load with `Must use import to load ES Module`. Keep 14.x
			// updates flowing; drop this rule once the Jest setup runs in ESM mode.
			matchPackageNames: ['nock'],
			allowedVersions: '<15',
		},
	],
}
